# ---------- copy to .env for local development ----------
# Models (one per agent). Cloud: Gemini. Local/offline: Ollama, e.g. ollama:qwen3:8b
GOOGLE_API_KEY=your-gemini-key
MANAGER_MODEL=google_genai:gemini-3.1-pro-preview
RESEARCH_MODEL=google_genai:gemini-3.5-flash
QUANT_MODEL=google_genai:gemini-3.5-flash
RISK_MODEL=google_genai:gemini-3.5-flash
EXECUTION_MODEL=google_genai:gemini-3.1-flash-lite
UTILITY_MODEL=google_genai:gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://localhost:11434

# Finance specialists: Fin-R1 via Ollama (local: `ollama pull hf.co/mradermacher/Fin-R1-GGUF:Q4_K_M`)
FINR1_URL=http://localhost:11434
FINBERT_ENABLED=true

# LangSmith monitoring
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=aureon

# Storage: leave as SQLite locally, or paste your Neon connection string
DATABASE_URL=sqlite+aiosqlite:///./trader.db
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Market data: yfinance (free, delayed) | angelone (free SmartAPI, live NSE+MCX) | synthetic
MARKET_DATA_PROVIDER=yfinance
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Access: one login page. Master accounts (ADMIN_USERS) + ADMIN_PASSCODE = broker console.
APP_PASSCODE=client123
ADMIN_PASSCODE=admin123
ADMIN_USERS=admin
SECRET_KEY=change-me-to-a-long-random-string
TICK_TOKEN=change-me
ENFORCE_MARKET_HOURS=true
WHISPER_MODEL=small

# AI spending limits (also editable in the admin House rules)
LLM_DAILY_BUDGET_USD=2
LLM_USER_DAILY_RUNS=25
LLM_MAX_CALLS_PER_RUN=45
